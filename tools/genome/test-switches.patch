+float g_st_last_e = 0;
+bool g_st_have = false;
+void test_stats(bool live, uintptr_t camera) {
+    double h = 0;
+    float e = 0;
+    if (live && read_heading(camera, h) && read_elevation(camera, e)) {
+        if (g_st_have) {
+            const double d = std::remainder(h - g_st_last_h, 360.0);
+            ++g_st_n;
+            g_st_h += d;
+            g_st_hsq += d * d;
+            g_st_hmin = std::min(g_st_hmin, d);
+            g_st_hmax = std::max(g_st_hmax, d);
+            g_st_e += double(e) - g_st_last_e;
+        }
+        g_st_last_h = h;
+        g_st_last_e = e;
+        g_st_have = true;
+    } else {
+        g_st_have = false;
+    }
